{
  "extends": [
    "github>harryzcy/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/|\\.)Dockerfile$/",
        "/(^|/)Dockerfile\\.[^/]*$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?)(?: depName=(?<depName>\\S+?))? packageName=(?<packageName>\\S+?)(?: versioning=(?<versioning>[a-z-]+?))?\\s(?:ENV|ARG) [A-Z0-9_]*VERSION=\"(?<currentValue>.+?)\"\\s"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/|\\.)Dockerfile$/",
        "/(^|/)Dockerfile\\.[^/]*$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?)(?: depName=(?<depName>\\S+?))? packageName=(?<packageName>\\S+?) ref=(?<currentValue>\\S+?)\\s(?:ENV|ARG) [A-Z0-9_]*VERSION=\"(?<currentDigest>[0-9a-f]+?)\"\\s"
      ]
    }
  ],
  "packageRules": [
    {
      "matchDatasources": "docker",
      "matchPackageNames": [
        "/(^|/)node$/"
      ],
      "matchFileNames": [
        "images/excalidraw/Dockerfile"
      ],
      "allowedVersions": ">=22.22.3 <23.0.0"
    }
  ]
}
